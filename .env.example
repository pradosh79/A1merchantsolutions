APP_NAME="AdCoupon Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adcoupon_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="coupons@adplatform.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- App-specific config ---
COUPON_CODE_LENGTH=8
COUPON_EXPIRY_DAYS=30
QR_CODE_SIZE=300
CLAIM_RATE_LIMIT_PER_MINUTE=5
MERCHANT_TOKEN_LENGTH=40

# --- Company / brand (public homepage, footer, emails) ---
COMPANY_NAME="A-1 Merchant Solutions"
COMPANY_TAGLINE="Zero Fee Processing"
COMPANY_PHONE="1800-000-000"
COMPANY_EMAIL="a1merchantsolutions@gmail.com"
COMPANY_LOGO_PATH="/images/logo.png"
COMPANY_FACEBOOK_URL=
COMPANY_INSTAGRAM_URL=
COMPANY_PINTEREST_URL=
COMPANY_LINKEDIN_URL=
